{
  "name": "wisdom-journey-server",
  "version": "1.0.0",
  "main": "src/index.ts",
  "repository": "git@github.com:ephiscience/wisdowm-journey-server.git",
  "private": true,
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@pothos/core": "^4.15.1",
    "@prisma/adapter-pg": "7.10.0",
