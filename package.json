{
  "name": "wisdom-journey-front",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --hmr --configuration=fr",
    "build": "ng build",
    "test": "ng test",
    "test:ci": "ng test --no-watch --no-progress --browsers=ChromeHeadlessCI",
    "test:ci:locales": "ng build --configuration lint-locales",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "bake": "ng build --configuration=production && docker buildx bake -f docker/github/ci.hcl -f docker/caddy-base/docker-bake.hcl -f docker-bake.hcl",
    "i18n": "ng extract-i18n --output-path src/locale"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.0.6",
    "@angular/common": "^20.0.6",
    "@angular/compiler": "^20.0.6",
    "@angular/core": "^20.0.6",
    "@angular/forms": "^20.0.6",
    "@angular/localize": "^20.0.6",
    "@angular/platform-browser": "^20.0.6",
    "@angular/platform-browser-dynamic": "^20.0.6",
    "@angular/router": "^20.0.6",
    "@apollo/client": "3.13.8",
    "@fontsource/chela-one": "^5.2.6",
    "@fontsource/roboto": "^5.2.6",
    "@ng-bootstrap/ng-bootstrap": "19.0.1",
    "@popperjs/core": "^2.11.8",
    "apollo-angular": "^11.0.0",
    "graphql": "^16.11.0",
    "luxon": "^3.6.1",
    "luxon-angular": "^6.0.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^20.0.5",
    "@angular/cli": "^20.0.5",
    "@angular/compiler-cli": "^20.0.6",
    "@types/jasmine": "~5.1.8",
    "@types/luxon": "^3.6.2",
    "@types/node": "^24.0.12",
    "angular-eslint": "20.1.1",
    "eslint": "^9.30.1",
    "jasmine-core": "~5.8.0",
    "jasmine-spec-reporter": "~7.0.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "ng-mocks": "^14.13.5",
    "prettier": "^3.6.2",
    "protractor": "~7.0.0",
    "ts-node": "~10.9.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.36.0"
  },
  "packageManager": "yarn@4.9.2",
  "volta": {
    "node": "24.4.0",
    "yarn": "4.9.2"
  }
}
