{
  "name": "wisdom-journey-front",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --hmr --configuration=fr",
    "build": "ng build",
    "test": "ng test",
    "test:ci": "ng test --no-watch --no-progress",
    "test:ci:locales": "ng build --configuration lint-locales",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "bake": "ng build --configuration=production && docker buildx bake -f docker/github/ci.hcl -f docker/caddy-base/docker-bake.hcl -f docker-bake.hcl",
    "i18n": "ng extract-i18n --output-path src/locale"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.2",
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/forms": "^22.2.2",
    "@angular/localize": "^22.2.2",
    "@angular/platform-browser": "^22.2.2",
    "@angular/platform-browser-dynamic": "^22.2.2",
    "@angular/router": "^22.2.2",
    "@apollo/client": "^4.3.3",
    "@fontsource/chela-one": "^5.2.6",
    "@fontsource/roboto": "^5.2.6",
    "@ng-bootstrap/ng-bootstrap": "21.0.0",
    "@popperjs/core": "^2.11.8",
    "apollo-angular": "^14.2.0",
    "graphql": "^16.11.0",
    "luxon": "^3.6.1",
    "luxon-angular": "^6.0.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.2",
    "@types/luxon": "^3.6.2",
    "@types/node": "^24.19.2",
    "angular-eslint": "22.6.0",
    "eslint": "^9.30.1",
    "jsdom": "^30.1.2",
    "ng-mocks": "^14.18.1",
    "prettier": "^3.6.2",
    "protractor": "~7.0.0",
    "ts-node": "~10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@12.11.2"
}
