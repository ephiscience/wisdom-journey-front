{
  "name": "wisdom-journey-front",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --hmr --configuration=fr",
    "build": "ng build",
    "test": "ng test",
    "test:ci": "ng test --no-watch --no-progress --browsers=ChromeHeadlessCI",
    "test:ci:locales": "ng build --configuration lint-locales",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "bake": "ng build --configuration=production && docker buildx bake -f docker/github/ci.hcl -f docker/caddy-base/docker-bake.hcl -f docker-bake.hcl",
    "i18n": "ng extract-i18n --output-path src/locale"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.25",
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/forms": "^21.2.25",
    "@angular/localize": "^21.2.25",
    "@angular/platform-browser": "^21.2.25",
    "@angular/platform-browser-dynamic": "^21.2.25",
    "@angular/router": "^21.2.25",
    "@apollo/client": "^4.3.3",
    "@fontsource/chela-one": "^5.2.6",
    "@fontsource/roboto": "^5.2.6",
    "@ng-bootstrap/ng-bootstrap": "20.0.0",
    "@popperjs/core": "^2.11.8",
    "apollo-angular": "^13.0.0",
    "graphql": "^16.11.0",
    "luxon": "^3.6.1",
    "luxon-angular": "^6.0.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.26",
    "@angular/cli": "^21.2.26",
    "@angular/compiler-cli": "^21.2.25",
    "@types/jasmine": "~5.1.8",
    "@types/luxon": "^3.6.2",
    "@types/node": "^24.0.12",
    "angular-eslint": "21.4.0",
    "eslint": "^9.30.1",
    "jasmine-core": "~5.8.0",
    "jasmine-spec-reporter": "~7.0.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "ng-mocks": "^14.18.1",
    "prettier": "^3.6.2",
    "protractor": "~7.0.0",
    "ts-node": "~10.9.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2"
  },
  "packageManager": "pnpm@12.11.2"
