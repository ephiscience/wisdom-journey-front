{
  "name": "wisdowm-journey-server",
  "version": "1.0.0",
  "main": "src/index.ts",
  "repository": "git@github.com:ephiscience/wisdowm-journey-server.git",
  "private": true,
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express4": "^1.1.2",
    "@pothos/core": "^4.15.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "express": "^4.21.2",
    "graphql": "^16.11.0",
    "morgan": "^1.10.0",
    "prisma": "7.10.0"
  },
  "scripts": {
    "load_questions": "node --unhandled-rejections=strict --import tsx ./src/scripts/load_questions.ts",
    "load_criterions": "node --unhandled-rejections=strict --import tsx ./src/scripts/load_criterions.ts",
    "schema": "tsx ./src/scripts/print_schema.ts",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/morgan": "^1.9.2",
    "@types/node": "^24",
    "@typescript-eslint/eslint-plugin": "^4.24",
    "@typescript-eslint/parser": "^4.24",
    "eslint": "^7.26",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^3.4",
    "prettier": "^2.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  },
  "packageManager": "yarn@1.22.22"
}
